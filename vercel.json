{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "type": "service",
        "service": "community-support-api"
      }
    }
  ],
  "services": {
    "community-support-api": {
      "root": ".",
      "buildCommand": "npm ci && npm run build",
      "entrypoint": "dist/app.js"
    }
  }
}

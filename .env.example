NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# PostgreSQL Connection String (Neon / Aiven)
DATABASE_URL=postgresql://user:password@ep-example.us-east-2.aws.neon.tech/neondb?sslmode=require

# JWT Secret for Authentication
JWT_SECRET=change-me-to-a-long-random-secret

# Optional Admin Auto-Seed
#ADMIN_EMAIL=admin@example.com
#ADMIN_PASSWORD=replace-with-strong-password

# CORS Allowed Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# ── Applink Integration (Backend-Only, Never prefix with NEXT_PUBLIC_) ────────
# Feature flags (default off)
APPLINK_FEATURES_ENABLED=false
APPLINK_OTP_ENABLED=false
APPLINK_DELIVERY_REPORTS_ENABLED=false

# Credentials (placeholders only — never commit real values)
APPLINK_APP_ID=APP_XXXXXX
APPLINK_PASSWORD=local-test-only

# Service URLs: configure ONLY enabled services. Unset = disabled.
# Local mock (run: node scripts/mock-applink.mjs):
#APPLINK_SMS_SEND_URL=http://127.0.0.1:8089/sms/send
#APPLINK_OTP_REQUEST_URL=http://127.0.0.1:8089/otp/request
#APPLINK_OTP_VERIFY_URL=http://127.0.0.1:8089/otp/verify
#APPLINK_SUBSCRIPTION_SEND_URL=http://127.0.0.1:8089/subscription/send

# Real production endpoints (uncomment ONLY after approval & IP allowlisting):
#APPLINK_SMS_SEND_URL=https://api.applink.com.bd/sms/send
#APPLINK_OTP_REQUEST_URL=https://api.applink.com.bd/otp/request
#APPLINK_OTP_VERIFY_URL=https://api.applink.com.bd/otp/verify
#APPLINK_SUBSCRIPTION_SEND_URL=https://api.applink.com.bd/subscription/send
